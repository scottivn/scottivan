{
  "name": "scottivan-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "sites/*",
    "lambdas/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@scottivan/portal",
    "dev:portal": "npm run dev --workspace=@scottivan/portal",
    "dev:me": "npm run dev --workspace=@scottivan/me",
    "build": "npm run build --workspaces --if-present",
    "build:portal": "npm run build --workspace=@scottivan/portal",
    "build:me": "npm run build --workspace=@scottivan/me",
    "lint": "npm run lint --workspaces --if-present",
    "aws:infra": "bash scripts/deploy-aws.sh",
    "aws:deploy": "bash scripts/deploy-all.sh",
    "aws:publish": "bash scripts/publish-site.sh",
    "aws:allowlist-ip": "bash scripts/update-allowlist-ip.sh",
    "aws:budget": "bash scripts/setup-budget.sh"
  }
}
